# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/locker?retryWrites=true&w=majority

# Optional: only needed when the URI does not include a database name
MONGODB_DB=locker

# Secret used to sign auth JWTs
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret

# AES-256-GCM key for locker identifier/credential encryption
# Generate with: openssl rand -hex 32
# Back this up: losing it means losing the encrypted data.
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-hex-characters
